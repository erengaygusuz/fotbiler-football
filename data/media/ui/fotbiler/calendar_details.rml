<rml>
<head>
  <title>Fotbiler Calendar</title>
  <link type="text/rcss" href="theme.rcss" />
  <link type="text/rcss" href="career_shell.rcss" />
  <link type="text/rcss" href="career_detail.rcss" />
</head>
<body>
  <div class="career-screen">
    <div class="career-bg-deep"></div><div class="career-bg-blue"></div><div class="career-bg-accent"></div>
    <div class="career-shell">
      <div class="career-topbar">
        <div class="club-identity"><div class="club-crest">F</div><div class="club-copy"><div id="career-club-name" class="club-name">FOTBILER FC</div><div id="career-club-meta" class="club-meta">MANAGER CAREER · SEASON 2026/27</div></div></div>
        <div class="career-status"><div class="status-block"><div class="status-label">CURRENT WEEK</div><div id="calendar-current-week" class="status-value">3</div></div><div class="status-block date-block"><div class="status-label">FIXTURES</div><div id="calendar-fixture-count" class="status-value">0</div></div></div>
      </div>
      <div class="career-tabs"><div class="career-tab" tabindex="0" data-route="career-central">CENTRAL</div><div class="career-tab" tabindex="0" data-route="squad">SQUAD</div><div class="career-tab" tabindex="0" data-route="transfers">TRANSFERS</div><div class="career-tab" tabindex="0" data-route="office">OFFICE</div><div class="career-tab active" tabindex="0" data-route="season">SEASON</div></div>

      <div class="career-detail-content">
        <div class="career-detail-main">
          <div class="ui-card career-detail-card full" tabindex="0">
            <div class="card-kicker">SCHEDULE</div><div class="career-detail-title">SEASON CALENDAR</div><div class="career-detail-subtitle">Fixtures and results for the current campaign.</div>
            <div class="detail-list-head"><span style="width:18%">MATCHDAY</span><span style="width:42%">FIXTURE</span><span style="width:18%">VENUE</span><span class="right" style="width:22%">RESULT</span></div>
            <div class="detail-list-row"><span style="width:18%">1</span><strong style="width:42%">FOTBILER FC · BLUE STAR</strong><span style="width:18%">HOME</span><span id="calendar-score-0" class="right" style="width:22%">2-0</span></div>
            <div class="detail-list-row"><span style="width:18%">2</span><strong style="width:42%">NORTH CITY · FOTBILER FC</strong><span style="width:18%">AWAY</span><span id="calendar-score-1" class="right" style="width:22%">1-1</span></div>
            <div class="detail-list-row active" tabindex="0" data-route="match-details"><span style="width:18%">3</span><strong style="width:42%">FOTBILER FC · ANKARA UNITED</strong><span style="width:18%">HOME</span><span id="calendar-score-2" class="right" style="width:22%">UPCOMING</span></div>
            <div class="detail-list-row"><span style="width:18%">4</span><strong style="width:42%">CAPITAL 06 · FOTBILER FC</strong><span style="width:18%">AWAY</span><span id="calendar-score-3" class="right" style="width:22%">UPCOMING</span></div>
            <div class="detail-list-row"><span style="width:18%">5</span><strong style="width:42%">FOTBILER FC · NORTH CITY</strong><span style="width:18%">HOME</span><span id="calendar-score-4" class="right" style="width:22%">UPCOMING</span></div>
            <div class="detail-list-row"><span style="width:18%">6</span><strong style="width:42%">BLUE STAR · FOTBILER FC</strong><span style="width:18%">AWAY</span><span id="calendar-score-5" class="right" style="width:22%">UPCOMING</span></div>
            <div class="detail-list-row"><span style="width:18%">7</span><strong style="width:42%">ANKARA UNITED · FOTBILER FC</strong><span style="width:18%">AWAY</span><span id="calendar-score-6" class="right" style="width:22%">UPCOMING</span></div>
            <div class="detail-list-row"><span style="width:18%">8</span><strong style="width:42%">FOTBILER FC · CAPITAL 06</strong><span style="width:18%">HOME</span><span id="calendar-score-7" class="right" style="width:22%">UPCOMING</span></div>
          </div>
        </div>
        <div class="career-detail-side">
          <div class="ui-card career-detail-card top dark" tabindex="0"><div class="card-kicker">NEXT MATCH</div><div class="career-detail-title light">ANKARA UNITED</div><div class="detail-hero-number">2</div><div class="detail-hero-label">DAYS TO KICK-OFF</div><div class="detail-copy">Home · Fotbiler Stadium · 19:00</div><span class="detail-action primary" data-route="match-details">MATCH DETAILS</span></div>
          <div class="ui-card career-detail-card bottom muted" tabindex="0"><div class="card-kicker">SEASON WINDOW</div><div class="career-detail-title">WEEK <span id="calendar-current-week-copy">3</span> / <span id="calendar-max-weeks">36</span></div><div class="detail-note">Fixture names and dates are the final live-integration boundary; the current CareerSave stores fixture IDs and scores while the league database resolves club names and dates.</div></div>
        </div>
      </div>

      <div class="career-control-strip"><div class="control-left"><span class="hint"><span class="hint-key">ENTER</span>Details</span><span class="hint"><span class="hint-key">ARROWS</span>Navigate</span><span class="hint"><span class="hint-key">ESC</span>Back</span></div><div class="control-right">SEASON · CALENDAR</div></div>
    </div>
  </div>
</body>
</rml>
