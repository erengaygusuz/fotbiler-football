<rml>
<head>
  <title>Fotbiler Settings</title>
  <link type="text/rcss" href="theme.rcss" />
  <link type="text/rcss" href="runtime_shell.rcss" />
</head>
<body>
  <div class="runtime-screen">
    <div class="runtime-bg-blue"></div><div class="runtime-bg-light"></div><div class="runtime-bg-pink"></div>
    <div class="runtime-shell">
      <div class="runtime-topbar"><div class="runtime-brand"><span class="runtime-brand-mark">F</span>OTBILER FOOTBALL</div><div class="runtime-meta">SETTINGS · PROFILE</div></div>
      <div class="runtime-heading"><div class="runtime-kicker">CUSTOMISE</div><div class="runtime-title">SETTINGS</div><div class="runtime-subtitle">Gameplay, display, audio, controls, camera and language.</div></div>
      <div class="runtime-content">
        <div class="runtime-column-main">
          <div class="runtime-card dark" style="height:100%;">
            <div class="runtime-card-kicker">DISPLAY</div><div class="runtime-card-title">VIDEO &amp; WINDOW</div>
            <div class="runtime-row" tabindex="0" autofocus data-action="toggle-fullscreen"><div class="runtime-label">WINDOW MODE</div><div id="settings-window-mode" class="runtime-value">FULLSCREEN</div></div>
            <div class="runtime-row" tabindex="0" data-action="cycle-resolution"><div class="runtime-label">RESOLUTION</div><div id="settings-resolution" class="runtime-value">1920 × 1080</div></div>
            <div class="runtime-row" tabindex="0" data-action="toggle-vsync"><div class="runtime-label">V-SYNC</div><div id="settings-vsync" class="runtime-value">ON</div></div>
            <div class="runtime-row" tabindex="0" data-action="cycle-difficulty"><div class="runtime-label">DEFAULT DIFFICULTY</div><div id="settings-difficulty" class="runtime-value">PROFESSIONAL</div></div>
            <div class="runtime-row" tabindex="0" data-action="cycle-game-speed"><div class="runtime-label">GAME SPEED</div><div id="settings-game-speed" class="runtime-value">NORMAL</div></div>
            <div class="runtime-row" tabindex="0" data-action="cycle-audio-volume"><div class="runtime-label">MASTER VOLUME</div><div id="settings-volume" class="runtime-value">80%</div></div>
          </div>
        </div>
        <div class="runtime-column-side">
          <div class="runtime-card" style="height:100%;">
            <div class="runtime-card-kicker">QUICK LINKS</div><div class="runtime-card-title">MORE SETTINGS</div>
            <div class="runtime-nav-item" tabindex="0" data-route="controller-select-modern">CONTROLS</div>
            <div class="runtime-nav-item" tabindex="0" data-route="camera-settings">CAMERA</div>
            <div class="runtime-nav-item" tabindex="0" data-route="visual-settings">VISUAL &amp; SYSTEM</div>
            <div class="runtime-nav-item" tabindex="0" data-action="apply-settings">APPLY &amp; SAVE</div>
            <div class="runtime-card-kicker" style="margin-top:18px;">NOTE</div><div class="runtime-muted">Fotbiler saves these frontend preferences and hands the selected display mode directly to the 3D match runtime.</div>
          </div>
        </div>
      </div>
      <div class="runtime-footer"><div><span class="runtime-hint"><span class="runtime-key">ENTER</span>Select</span><span class="runtime-hint"><span class="runtime-key">ESC</span>Back</span></div><div>M1C · SETTINGS</div></div>
    </div>
  </div>
</body>
</rml>