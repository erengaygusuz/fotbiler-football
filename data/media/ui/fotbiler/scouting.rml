<rml>
<head>
  <title>Fotbiler Scouting</title>
  <link type="text/rcss" href="theme.rcss" />
  <link type="text/rcss" href="career_shell.rcss" />
  <link type="text/rcss" href="career_detail.rcss" />
</head>
<body>
  <div class="career-screen">
    <div class="career-bg-deep"></div><div class="career-bg-blue"></div><div class="career-bg-accent"></div>
    <div class="career-shell">
      <div class="career-topbar">
        <div class="club-identity"><div class="club-crest">F</div><div class="club-copy"><div id="career-club-name" class="club-name">FOTBILER FC</div><div id="career-club-meta" class="club-meta">MANAGER CAREER · SEASON 2026/27</div></div></div>
        <div class="career-status"><div class="status-block"><div class="status-label">ACTIVE REGION</div><div id="scouting-region" class="status-value">PORTUGAL</div></div><div class="status-block date-block"><div class="status-label">MONTHS LEFT</div><div id="scouting-months" class="status-value">1</div></div></div>
      </div>
      <div class="career-tabs"><div class="career-tab" tabindex="0" data-route="career-central">CENTRAL</div><div class="career-tab" tabindex="0" data-route="squad">SQUAD</div><div class="career-tab active" tabindex="0" data-route="transfers">TRANSFERS</div><div class="career-tab" tabindex="0" data-route="office">OFFICE</div><div class="career-tab" tabindex="0" data-route="season">SEASON</div></div>

      <div class="career-detail-content">
        <div class="career-detail-main">
          <div class="ui-card career-detail-card full" tabindex="0">
            <div class="card-kicker">PLAYER DISCOVERY</div><div class="career-detail-title">SCOUT REPORTS</div><div class="career-detail-subtitle">Estimates improve as report quality increases.</div>
            <div class="detail-list-head"><span style="width:32%">PLAYER</span><span style="width:10%">POS</span><span style="width:10%">AGE</span><span style="width:16%">OVR</span><span style="width:16%">POT</span><span class="right" style="width:16%">REPORT</span></div>
            <div class="detail-list-row active"><strong id="scout-name-0" style="width:32%">JOAO SILVA</strong><span id="scout-pos-0" style="width:10%">ST</span><span id="scout-age-0" style="width:10%">22</span><span id="scout-ovr-0" style="width:16%">80-82</span><span id="scout-pot-0" style="width:16%">84-87</span><span id="scout-report-0" class="right" style="width:16%">100</span></div>
            <div class="detail-list-row"><strong id="scout-name-1" style="width:32%">MATEO RUIZ</strong><span id="scout-pos-1" style="width:10%">CM</span><span id="scout-age-1" style="width:10%">24</span><span id="scout-ovr-1" style="width:16%">78-80</span><span id="scout-pot-1" style="width:16%">81-84</span><span id="scout-report-1" class="right" style="width:16%">82</span></div>
            <div class="detail-list-row"><strong id="scout-name-2" style="width:32%">LEON VOGEL</strong><span id="scout-pos-2" style="width:10%">CB</span><span id="scout-age-2" style="width:10%">21</span><span id="scout-ovr-2" style="width:16%">76-79</span><span id="scout-pot-2" style="width:16%">82-86</span><span id="scout-report-2" class="right" style="width:16%">70</span></div>
            <div class="detail-list-row"><strong id="scout-name-3" style="width:32%">OMAR HADDAD</strong><span id="scout-pos-3" style="width:10%">RW</span><span id="scout-age-3" style="width:10%">23</span><span id="scout-ovr-3" style="width:16%">76-78</span><span id="scout-pot-3" style="width:16%">80-83</span><span id="scout-report-3" class="right" style="width:16%">64</span></div>
            <div class="detail-list-row"><strong id="scout-name-4" style="width:32%">EMIL BORG</strong><span id="scout-pos-4" style="width:10%">GK</span><span id="scout-age-4" style="width:10%">25</span><span id="scout-ovr-4" style="width:16%">75-77</span><span id="scout-pot-4" style="width:16%">78-81</span><span id="scout-report-4" class="right" style="width:16%">58</span></div>
          </div>
        </div>
        <div class="career-detail-side">
          <div class="ui-card career-detail-card top dark" tabindex="0"><div class="card-kicker">NETWORK STATUS</div><div class="career-detail-title light">ACTIVE ASSIGNMENT</div><div class="detail-hero-number" id="scouting-months-copy">1</div><div class="detail-hero-label">MONTH REMAINING</div><div class="detail-copy">Current search region: <strong id="scouting-region-copy">PORTUGAL</strong>.</div><span class="detail-action primary">EDIT ASSIGNMENT</span><span class="detail-action">STOP SEARCH</span></div>
          <div class="ui-card career-detail-card bottom muted" tabindex="0"><div class="card-kicker">PIPELINE</div><div class="career-detail-title">SCOUTING TOTALS</div><div class="detail-stat-grid"><div class="detail-stat accent"><span>SHORTLIST</span><strong id="scouting-shortlist-count">1</strong></div><div class="detail-stat"><span>DISCOVERED</span><strong id="scouting-discovered-count">0</strong></div><div class="detail-stat"><span>SCOUTS</span><strong>2</strong></div></div></div>
        </div>
      </div>

      <div class="career-control-strip"><div class="control-left"><span class="hint"><span class="hint-key">ENTER</span>Select</span><span class="hint"><span class="hint-key">ARROWS</span>Navigate</span><span class="hint"><span class="hint-key">ESC</span>Back</span></div><div class="control-right">TRANSFERS · SCOUTING</div></div>
    </div>
  </div>
</body>
</rml>
