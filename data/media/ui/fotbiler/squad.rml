<rml>
<head>
  <title>Fotbiler Squad</title>
  <link type="text/rcss" href="theme.rcss" />
  <link type="text/rcss" href="career_shell.rcss" />
  <link type="text/rcss" href="squad.rcss" />
</head>
<body>
  <div class="career-screen">
    <div class="career-bg-deep"></div>
    <div class="career-bg-blue"></div>
    <div class="career-bg-accent"></div>
    <div class="career-shell">
      <div class="career-topbar">
        <div class="club-identity">
          <div class="club-crest">F</div>
          <div class="club-copy"><div id="career-club-name" class="club-name">FOTBILER FC</div><div id="career-club-meta" class="club-meta">MANAGER CAREER · SEASON 2026/27</div></div>
        </div>
        <div class="career-status"><div class="status-block"><div class="status-label">SQUAD SIZE</div><div id="career-squad-size" class="status-value">24</div></div><div class="status-block date-block"><div class="status-label">FORMATION</div><div id="career-formation" class="status-value">4-2-3-1</div></div></div>
      </div>
      <div class="career-tabs">
        <div class="career-tab" tabindex="0" data-route="career-central">CENTRAL</div><div class="career-tab active" tabindex="0" data-route="squad">SQUAD</div><div class="career-tab" tabindex="0" data-route="transfers">TRANSFERS</div><div class="career-tab" tabindex="0" data-route="office">OFFICE</div><div class="career-tab" tabindex="0" data-route="season">SEASON</div>
      </div>
      <div class="squad-content">
        <div class="squad-main">
          <div class="squad-toolbar"><div><div class="card-kicker">STARTING XI</div><div class="squad-title">TEAM MANAGEMENT</div></div><div class="squad-toolbar-right">BALANCED · 4-2-3-1</div></div>
          <div id="formation-pitch" class="formation-pitch" tabindex="0">
            <div class="pitch-outline"></div><div class="pitch-half-line"></div><div class="pitch-circle"></div><div class="pitch-center-dot"></div><div class="pitch-box top-box"></div><div class="pitch-six top-six"></div><div class="pitch-box bottom-box"></div><div class="pitch-six bottom-six"></div>
            <div class="player-node pos-st"><div id="formation-ovr-0" class="player-disc">78</div><div id="formation-name-0" class="player-name">KAYA</div><div id="formation-pos-0" class="player-pos">ST</div></div>
            <div class="player-node pos-lw"><div id="formation-ovr-1" class="player-disc">75</div><div id="formation-name-1" class="player-name">DEMIR</div><div id="formation-pos-1" class="player-pos">LW</div></div>
            <div class="player-node selected pos-cam"><div id="formation-ovr-2" class="player-disc">81</div><div id="formation-name-2" class="player-name">YILMAZ</div><div id="formation-pos-2" class="player-pos">CAM</div></div>
            <div class="player-node pos-rw"><div id="formation-ovr-3" class="player-disc">76</div><div id="formation-name-3" class="player-name">ASLAN</div><div id="formation-pos-3" class="player-pos">RW</div></div>
            <div class="player-node pos-lcm"><div id="formation-ovr-4" class="player-disc">77</div><div id="formation-name-4" class="player-name">AKSOY</div><div id="formation-pos-4" class="player-pos">CM</div></div>
            <div class="player-node pos-rcm"><div id="formation-ovr-5" class="player-disc">74</div><div id="formation-name-5" class="player-name">EREN</div><div id="formation-pos-5" class="player-pos">CM</div></div>
            <div class="player-node pos-lb"><div id="formation-ovr-6" class="player-disc">72</div><div id="formation-name-6" class="player-name">CAN</div><div id="formation-pos-6" class="player-pos">LB</div></div>
            <div class="player-node pos-lcb"><div id="formation-ovr-7" class="player-disc">79</div><div id="formation-name-7" class="player-name">TUNA</div><div id="formation-pos-7" class="player-pos">CB</div></div>
            <div class="player-node pos-rcb"><div id="formation-ovr-8" class="player-disc">78</div><div id="formation-name-8" class="player-name">ARDA</div><div id="formation-pos-8" class="player-pos">CB</div></div>
            <div class="player-node pos-rb"><div id="formation-ovr-9" class="player-disc">73</div><div id="formation-name-9" class="player-name">MERT</div><div id="formation-pos-9" class="player-pos">RB</div></div>
            <div class="player-node pos-gk"><div id="formation-ovr-10" class="player-disc">80</div><div id="formation-name-10" class="player-name">OZAN</div><div id="formation-pos-10" class="player-pos">GK</div></div>
          </div>
        </div>
        <div class="squad-side">
          <div id="selected-player" class="squad-card selected-player-card" tabindex="0"><div class="selected-accent"></div><div class="selected-top"><div><div class="card-kicker">SELECTED PLAYER</div><div id="selected-player-name" class="selected-name">EMRE YILMAZ</div><div id="selected-player-meta" class="selected-meta">CAM · #10 · TURKEY</div></div><div class="overall-block"><span id="selected-player-overall" class="overall-number">81</span><span class="overall-label">OVR</span></div></div><div class="selected-status-row"><span class="status-pill good">FIT 94%</span><span class="status-pill">FORM GOOD</span><span class="status-pill">MORALE HAPPY</span></div><div class="attribute-grid"><div class="attribute-cell"><span>PAC</span><strong>78</strong></div><div class="attribute-cell"><span>SHO</span><strong>76</strong></div><div class="attribute-cell accent"><span>PAS</span><strong>84</strong></div><div class="attribute-cell accent"><span>DRI</span><strong>83</strong></div><div class="attribute-cell"><span>DEF</span><strong>52</strong></div><div class="attribute-cell"><span>PHY</span><strong>68</strong></div></div><div class="selected-footer"><span id="selected-player-value">VALUE €24M</span><span id="selected-player-contract">CONTRACT 2029</span></div></div>
          <div id="squad-list" class="squad-card squad-list-card" tabindex="0"><div class="squad-list-header"><span class="card-kicker">SQUAD</span><span class="list-count">24 PLAYERS</span></div><div class="list-head"><span>PLAYER</span><span>POS</span><span>OVR</span><span>FIT</span></div>
            <div class="list-row active"><span id="squad-list-name-0">EMRE YILMAZ</span><span id="squad-list-pos-0">CAM</span><span id="squad-list-ovr-0">81</span><span id="squad-list-fit-0">94</span></div>
            <div class="list-row"><span id="squad-list-name-1">OZAN KOC</span><span id="squad-list-pos-1">GK</span><span id="squad-list-ovr-1">80</span><span id="squad-list-fit-1">96</span></div>
            <div class="list-row"><span id="squad-list-name-2">TUNA CELIK</span><span id="squad-list-pos-2">CB</span><span id="squad-list-ovr-2">79</span><span id="squad-list-fit-2">91</span></div>
            <div class="list-row"><span id="squad-list-name-3">ARDA GUNES</span><span id="squad-list-pos-3">CB</span><span id="squad-list-ovr-3">78</span><span id="squad-list-fit-3">89</span></div>
            <div class="list-row"><span id="squad-list-name-4">KEREM KAYA</span><span id="squad-list-pos-4">ST</span><span id="squad-list-ovr-4">78</span><span id="squad-list-fit-4">92</span></div>
            <div class="list-row"><span id="squad-list-name-5">AHMET AKSOY</span><span id="squad-list-pos-5">CM</span><span id="squad-list-ovr-5">77</span><span id="squad-list-fit-5">87</span></div>
          </div>
        </div>
      </div>
      <div class="career-control-strip"><div class="control-left"><span class="hint"><span class="hint-key">ENTER</span>Select</span><span class="hint"><span class="hint-key">ARROWS</span>Navigate</span><span class="hint"><span class="hint-key">F1</span>Main Menu</span><span class="hint"><span class="hint-key">F2</span>Central</span><span class="hint"><span class="hint-key">F3</span>Squad</span></div><div class="control-right">SQUAD · STARTING XI</div></div>
    </div>
  </div>
</body>
</rml>
