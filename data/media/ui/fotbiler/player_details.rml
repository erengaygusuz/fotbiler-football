<rml>
<head>
  <title>Fotbiler Player Details</title>
  <link type="text/rcss" href="theme.rcss" />
  <link type="text/rcss" href="career_shell.rcss" />
  <link type="text/rcss" href="career_detail.rcss" />
</head>
<body>
  <div class="career-screen">
    <div class="career-bg-deep"></div><div class="career-bg-blue"></div><div class="career-bg-accent"></div>
    <div class="career-shell">
      <div class="career-topbar"><div class="club-identity"><div class="club-crest">F</div><div class="club-copy"><div id="career-club-name" class="club-name">FOTBILER FC</div><div id="career-club-meta" class="club-meta">MANAGER CAREER · SEASON 2026/27</div></div></div><div class="career-status"><div class="status-block"><div class="status-label">PLAYER</div><div id="selected-player-overall" class="status-value">81 OVR</div></div><div class="status-block date-block"><div class="status-label">STATUS</div><div class="status-value">AVAILABLE</div></div></div></div>
      <div class="career-tabs"><div class="career-tab" tabindex="0" data-route="career-central">CENTRAL</div><div class="career-tab active" tabindex="0" data-route="squad">SQUAD</div><div class="career-tab" tabindex="0" data-route="transfers">TRANSFERS</div><div class="career-tab" tabindex="0" data-route="office">OFFICE</div><div class="career-tab" tabindex="0" data-route="season">SEASON</div></div>
      <div class="career-detail-nav"><div class="career-detail-nav-item" tabindex="0" data-route="squad">TEAM SHEET</div><div class="career-detail-nav-item" tabindex="0" data-route="tactics">TACTICS</div><div class="career-detail-nav-item active" tabindex="0" data-route="player-details">PLAYER DETAILS</div><div class="career-detail-nav-item" tabindex="0" data-route="youth-academy">YOUTH ACADEMY</div></div>

      <div class="career-detail-content">
        <div class="career-detail-main">
          <div class="ui-card career-detail-card top dark" tabindex="0"><div class="card-kicker">PLAYER PROFILE</div><div id="selected-player-name" class="career-detail-title light">EMRE YILMAZ</div><div id="selected-player-meta" class="career-detail-subtitle">CAM · AGE 24</div><div class="detail-stat-grid"><div class="detail-stat accent"><span>OVERALL</span><strong id="selected-player-overall-copy">81</strong></div><div class="detail-stat"><span>POTENTIAL</span><strong>85</strong></div><div class="detail-stat"><span>FITNESS</span><strong>94</strong></div><div class="detail-stat"><span>MORALE</span><strong>78</strong></div><div class="detail-stat"><span>FORM</span><strong>GOOD</strong></div><div class="detail-stat"><span>ROLE</span><strong>STARTER</strong></div></div></div>
          <div class="ui-card career-detail-card bottom" tabindex="0"><div class="card-kicker">SEASON CONTRIBUTION</div><div class="career-detail-title">PERFORMANCE</div><div class="detail-stat-grid"><div class="detail-stat accent"><span>APPEARANCES</span><strong>2</strong></div><div class="detail-stat"><span>GOALS</span><strong>1</strong></div><div class="detail-stat"><span>ASSISTS</span><strong>2</strong></div></div></div>
        </div>
        <div class="career-detail-side"><div class="ui-card career-detail-card top muted" tabindex="0"><div class="card-kicker">CONTRACT</div><div class="career-detail-title">PLAYER VALUE</div><div id="selected-player-value" class="detail-hero-number">VALUE €24M</div><div id="selected-player-contract" class="detail-note">CONTRACT 3Y</div><span class="detail-action primary">NEGOTIATE</span><span class="detail-action">TRANSFER</span></div><div class="ui-card career-detail-card bottom dark" tabindex="0"><div class="card-kicker">DEVELOPMENT</div><div class="career-detail-title light">TRAINING PLAN</div><div class="detail-copy">Current weekly focus is inherited from the squad training state.</div><span class="detail-action primary">SET FOCUS</span><span class="detail-action">VIEW REPORT</span></div></div>
      </div>
      <div class="career-control-strip"><div class="control-left"><span class="hint"><span class="hint-key">ENTER</span>Select</span><span class="hint"><span class="hint-key">ARROWS</span>Navigate</span><span class="hint"><span class="hint-key">ESC</span>Back</span></div><div class="control-right">SQUAD · PLAYER DETAILS</div></div>
    </div>
  </div>
</body>
</rml>
