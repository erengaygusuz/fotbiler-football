body { font-family: "Fotbiler Sans"; }

/* Anchor the page to the available career shell so the bottom controls never fall outside the viewport. */
.tactics-content {
  position: absolute;
  left: 0;
  top: 17.5%;
  bottom: 10.5%;
  width: 100%;
  height: auto;
  padding-top: 12px;
  box-sizing: border-box;
}
.tactics-content + .career-control-strip {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 8.5%;
  margin-top: 0;
}

.tactics-subtabs { display: flex; width: 100%; height: 8%; background-color: #e7ecef; border-bottom-width: 1px; border-bottom-color: #cbd4d9; }
.tactics-subtab { position: relative; box-sizing: border-box; padding: 10px 20px 8px; color: #657a87; font-size: 11px; letter-spacing: 1px; }
.tactics-subtab.active { color: #10202d; font-family: "Fotbiler Display"; border-bottom-width: 4px; border-bottom-color: #19d3b1; }

.tactics-main-row { display: flex; width: 100%; height: 79%; margin-top: 1.2%; }
.tactics-left { width: 58%; height: 100%; margin-right: 2%; }
.tactics-right { width: 40%; height: 100%; }

.tactics-toolbar { display: flex; width: 100%; height: 14%; padding: 11px 17px; box-sizing: border-box; align-items: center; justify-content: space-between; background-color: #f7f8f9; }
.tactics-title { display: block; margin-top: 2px; font-family: "Fotbiler Display"; font-size: 25px; line-height: 27px; }
.shape-meta { color: #5e7685; font-size: 11px; letter-spacing: 0.9px; }

.tactics-pitch { height: 83%; margin-top: 2%; }
.tactics-pitch .player-node { width: 80px; }
.tactics-pitch .player-disc { width: 46px; height: 46px; line-height: 46px; border-radius: 23px; font-size: 17px; }
.tactics-pitch .player-name { margin-top: 3px; font-size: 12px; }
.tactics-pitch .player-pos { font-size: 9px; }

/* The three extra horizontal tactical-zone guides were visually competing with the real pitch markings. */
.tactic-line { display: none; }

.tactic-card { position: relative; width: 100%; box-sizing: border-box; overflow: hidden; background-color: #f7f8f9; border-width: 2px; border-color: #f7f8f9; color: #10202d; nav: auto; transition: transform border-color 0.15s sine-out; }
.tactic-card:hover, .tactic-card:focus { transform: translateY(-2px); border-color: #ffffff; }
.identity-card { height: 57%; padding: 16px 19px; background-color: #17334a; border-color: #17334a; color: #ffffff; }
.light-kicker { color: #9fb2bd; }
.tactic-card-title { display: block; margin-top: 3px; font-family: "Fotbiler Display"; font-size: 23px; line-height: 25px; }
.light-title { color: #ffffff; }

.style-section { margin-top: 9px; }
.attack-section { margin-top: 10px; padding-top: 9px; border-top-width: 1px; border-top-color: #34546a; }
.style-heading { display: flex; width: 100%; justify-content: space-between; align-items: center; }
.style-heading span { color: #19d3b1; font-size: 10px; letter-spacing: 0.9px; }
.style-heading strong { color: #ffffff; font-family: "Fotbiler Display"; font-size: 12px; }
.metric-row { display: flex; width: 100%; margin-top: 6px; color: #a9bbc6; font-size: 10px; justify-content: space-between; }
.metric-row strong { color: #ffffff; font-family: "Fotbiler Display"; font-size: 12px; }
.metric-track { width: 100%; height: 5px; margin-top: 4px; background-color: #27495f; }
.metric-fill { height: 100%; background-color: #19d3b1; }
.width-45 { width: 45%; }
.width-55 { width: 55%; }
.width-58 { width: 58%; }
.width-60 { width: 60%; }

.instructions-card { height: 41%; margin-top: 2%; padding: 13px 17px; }
.instructions-head { display: flex; width: 100%; justify-content: space-between; }
.instructions-card .tactic-card-title { font-size: 20px; line-height: 22px; }
.instructions-card .card-kicker, .instructions-card .small-link { font-size: 10px; }
.instruction-row { display: flex; width: 100%; box-sizing: border-box; margin-top: 4px; padding: 6px 8px; border-bottom-width: 1px; border-bottom-color: #dce2e5; font-size: 10px; align-items: center; }
.instruction-row.active { background-color: #19d3b1; border-bottom-color: #19d3b1; color: #10202d; }
.instruction-pos { width: 10%; color: #617887; }
.instruction-row.active .instruction-pos { color: #10202d; }
.instruction-player { width: 30%; font-family: "Fotbiler Display"; font-size: 12px; }
.instruction-text { width: 60%; text-align: right; color: #5f7481; letter-spacing: 0.6px; }
.instruction-row.active .instruction-text { color: #10202d; }

.mentality-strip { display: flex; width: 100%; height: 9%; margin-top: 1.2%; }
/* RmlUi was not painting direct text consistently while these cards were flex containers. Use normal block text flow and vertically pad each label. */
.mentality-card {
  display: block;
  width: 19.2%;
  height: 100%;
  margin-right: 1%;
  box-sizing: border-box;
  padding: 9px 10px 0;
  background-color: #dfe5e9;
  border-width: 2px;
  border-color: #dfe5e9;
  color: #486171;
  text-align: center;
  font-family: "Fotbiler Display";
  font-size: 11px;
  line-height: 14px;
  letter-spacing: 0.7px;
}
.mentality-card:last-child { margin-right: 0; }
.mentality-card.active { padding-top: 6px; background-color: #19d3b1; border-color: #ffffff; color: #10202d; nav: auto; }
.mentality-card.active span { display: block; font-family: "Fotbiler Display"; font-size: 14px; line-height: 15px; }
.mentality-card.active strong { display: block; margin-top: 1px; font-size: 8px; line-height: 10px; letter-spacing: 1px; }
