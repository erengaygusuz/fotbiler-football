body { font-family: "Fotbiler Sans"; }

.tactics-content { width: 100%; height: 61%; padding-top: 14px; }
.tactics-subtabs { display: flex; width: 100%; height: 7%; background-color: #e7ecef; border-bottom-width: 1px; border-bottom-color: #cbd4d9; }
.tactics-subtab { position: relative; padding: 10px 20px 8px; color: #657a87; font-size: 9px; letter-spacing: 1px; }
.tactics-subtab.active { color: #10202d; font-family: "Fotbiler Display"; }
.tactics-subtab.active:after { content: ""; position: absolute; left: 18px; right: 18px; bottom: 0; height: 4px; background-color: #19d3b1; }

.tactics-main-row { display: flex; width: 100%; height: 80%; margin-top: 1.4%; }
.tactics-left { width: 58%; height: 100%; margin-right: 2%; }
.tactics-right { width: 40%; height: 100%; }

.tactics-toolbar { display: flex; width: 100%; height: 13%; padding: 10px 16px; box-sizing: border-box; align-items: center; justify-content: space-between; background-color: #f7f8f9; }
.tactics-title { display: block; margin-top: 2px; font-family: "Fotbiler Display"; font-size: 22px; line-height: 24px; }
.shape-meta { color: #5e7685; font-size: 9px; letter-spacing: 0.9px; }

.tactics-pitch { height: 84%; margin-top: 2%; }
.tactics-pitch .player-node { width: 72px; }
.tactics-pitch .player-disc { width: 40px; height: 40px; line-height: 40px; border-radius: 20px; font-size: 15px; }
.tactics-pitch .player-name { margin-top: 2px; font-size: 10px; }
.tactics-pitch .player-pos { font-size: 7px; }
.tactic-line { position: absolute; left: 12%; width: 76%; height: 2px; background-color: #2c6177; }
.attacking-line { top: 31%; }
.midfield-line { top: 52%; }
.defensive-line { top: 72%; }

.tactic-card { position: relative; width: 100%; box-sizing: border-box; overflow: hidden; background-color: #f7f8f9; border-width: 2px; border-color: #f7f8f9; color: #10202d; nav: auto; transition: transform border-color 0.15s sine-out; }
.tactic-card:hover, .tactic-card:focus { transform: translateY(-2px); border-color: #ffffff; }
.identity-card { height: 58%; padding: 14px 17px; background-color: #17334a; border-color: #17334a; color: #ffffff; }
.light-kicker { color: #9fb2bd; }
.tactic-card-title { display: block; margin-top: 2px; font-family: "Fotbiler Display"; font-size: 20px; line-height: 22px; }
.light-title { color: #ffffff; }

.style-section { margin-top: 8px; }
.attack-section { margin-top: 9px; padding-top: 8px; border-top-width: 1px; border-top-color: #34546a; }
.style-heading { display: flex; width: 100%; justify-content: space-between; align-items: center; }
.style-heading span { color: #19d3b1; font-size: 8px; letter-spacing: 0.9px; }
.style-heading strong { color: #ffffff; font-family: "Fotbiler Display"; font-size: 10px; }
.metric-row { display: flex; width: 100%; margin-top: 5px; color: #a9bbc6; font-size: 8px; justify-content: space-between; }
.metric-row strong { color: #ffffff; font-family: "Fotbiler Display"; font-size: 10px; }
.metric-track { width: 100%; height: 4px; margin-top: 3px; background-color: #27495f; }
.metric-fill { height: 100%; background-color: #19d3b1; }
.width-45 { width: 45%; }
.width-55 { width: 55%; }
.width-58 { width: 58%; }
.width-60 { width: 60%; }

.instructions-card { height: 40%; margin-top: 2%; padding: 12px 15px; }
.instructions-head { display: flex; width: 100%; justify-content: space-between; }
.instructions-card .tactic-card-title { font-size: 17px; line-height: 19px; }
.instruction-row { display: flex; width: 100%; box-sizing: border-box; margin-top: 4px; padding: 5px 7px; border-bottom-width: 1px; border-bottom-color: #dce2e5; font-size: 8px; align-items: center; }
.instruction-row.active { background-color: #19d3b1; border-bottom-color: #19d3b1; color: #10202d; }
.instruction-pos { width: 10%; color: #617887; }
.instruction-row.active .instruction-pos { color: #10202d; }
.instruction-player { width: 30%; font-family: "Fotbiler Display"; font-size: 10px; }
.instruction-text { width: 60%; text-align: right; color: #5f7481; letter-spacing: 0.6px; }
.instruction-row.active .instruction-text { color: #10202d; }

.mentality-strip { display: flex; width: 100%; height: 9%; margin-top: 1.4%; }
.mentality-card { display: flex; width: 19.2%; height: 100%; margin-right: 1%; box-sizing: border-box; padding: 0 10px; align-items: center; justify-content: center; background-color: #dfe5e9; border-width: 2px; border-color: #dfe5e9; color: #486171; text-align: center; font-size: 8px; letter-spacing: 0.7px; }
.mentality-card:last-child { margin-right: 0; }
.mentality-card.active { display: block; padding-top: 5px; background-color: #19d3b1; border-color: #ffffff; color: #10202d; nav: auto; }
.mentality-card.active span { display: block; font-family: "Fotbiler Display"; font-size: 12px; }
.mentality-card.active strong { display: block; margin-top: 1px; font-size: 7px; letter-spacing: 1px; }
