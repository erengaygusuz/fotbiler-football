<rml>
<head>
  <title>Fotbiler Career Central</title>
  <link type="text/rcss" href="theme.rcss" />
  <link type="text/rcss" href="career_shell.rcss" />
  <link type="text/rcss" href="career_central.rcss" />
</head>
<body>
  <div class="career-screen">
    <div class="career-bg-deep"></div>
    <div class="career-bg-blue"></div>
    <div class="career-bg-accent"></div>
    <div class="career-shell">
      <div class="career-topbar">
        <div class="club-identity"><div class="club-crest">F</div><div class="club-copy"><div id="career-club-name" class="club-name">FOTBILER FC</div><div id="career-club-meta" class="club-meta">MANAGER CAREER · SEASON 2026/27</div></div></div>
        <div class="career-status"><div class="status-block"><div class="status-label">TRANSFER BUDGET</div><div id="career-transfer-budget" class="status-value">€24.5M</div></div><div class="status-block date-block"><div class="status-label">AUGUST</div><div class="status-value">17</div></div></div>
      </div>
      <div class="career-tabs">
        <div class="career-tab active" tabindex="0" data-route="career-central">CENTRAL</div>
        <div class="career-tab" tabindex="0" data-route="squad">SQUAD</div>
        <div class="career-tab" tabindex="0" data-route="transfers">TRANSFERS</div>
        <div class="career-tab" tabindex="0" data-route="office">OFFICE</div>
        <div class="career-tab" tabindex="0" data-route="season">SEASON</div>
      </div>
      <div class="career-content">
        <div class="career-primary">
          <div id="career-next-match" class="career-card next-match" tabindex="0"><div class="card-kicker">NEXT MATCH</div><div class="match-competition">FOTBILER PREMIER LEAGUE · MATCHDAY 3</div><div class="match-stage"><div class="team-side home-side"><div class="crest-large crest-home">F</div><div class="team-name">FOTBILER FC</div></div><div class="versus-block"><div class="match-day">SATURDAY</div><div class="versus">VS</div><div class="match-time">19:00</div></div><div class="team-side away-side"><div class="crest-large crest-away">A</div><div class="team-name">ANKARA UNITED</div></div></div><div class="match-footer"><span>HOME</span><span>FOTBILER STADIUM</span><span>2 DAYS</span></div></div>
          <div class="career-lower-row">
            <div id="career-table" class="career-card league-table" tabindex="0"><div class="card-header-row"><div class="card-kicker">LEAGUE TABLE</div><div class="card-link">FULL TABLE</div></div><div class="table-head"><span class="col-pos">POS</span><span class="col-club">CLUB</span><span class="col-pl">PL</span><span class="col-pts">PTS</span></div><div class="table-row"><span class="col-pos">1</span><span class="col-club">NORTH CITY</span><span class="col-pl">2</span><span class="col-pts">6</span></div><div class="table-row"><span class="col-pos">2</span><span class="col-club">ANKARA UNITED</span><span class="col-pl">2</span><span class="col-pts">6</span></div><div class="table-row current"><span class="col-pos">3</span><span class="col-club">FOTBILER FC</span><span class="col-pl">2</span><span class="col-pts">4</span></div><div class="table-row"><span class="col-pos">4</span><span class="col-club">CAPITAL 06</span><span class="col-pl">2</span><span class="col-pts">4</span></div><div class="table-row"><span class="col-pos">5</span><span class="col-club">BLUE STAR</span><span class="col-pl">2</span><span class="col-pts">3</span></div></div>
            <div id="career-form" class="career-card form-card" tabindex="0"><div class="card-kicker">TEAM FORM</div><div class="form-title">UNBEATEN START</div><div class="form-dots"><span class="form-dot win">W</span><span class="form-dot draw">D</span><span class="form-dot win">W</span><span class="form-dot empty">-</span><span class="form-dot empty">-</span></div><div class="form-stat"><span>GOALS</span><strong id="central-form-goals">5</strong></div><div class="form-stat"><span>CONCEDED</span><strong id="central-form-conceded">2</strong></div><div class="form-stat"><span>POSITION</span><strong id="central-form-position">3</strong></div></div>
          </div>
        </div>
        <div class="career-secondary">
          <div id="career-news" class="career-card career-news" tabindex="0"><div class="news-accent-line"></div><div class="card-kicker">CLUB NEWS</div><div class="news-date">TODAY · 09:35</div><div class="career-news-title">FOTBILER PREPARE FOR EARLY-SEASON TEST</div><div class="career-news-copy">The squad returns to training ahead of Saturday's home fixture against Ankara United.</div><div class="news-footer">READ STORY</div></div>
          <div id="career-office" class="career-card office-card" tabindex="0"><div class="office-column"><div class="card-kicker">INBOX</div><div id="central-inbox-count" class="office-number">3</div><div class="office-label">UNREAD MESSAGES</div><div class="office-item">Scout report ready</div><div class="office-item">Player development update</div></div><div class="office-divider"></div><div class="office-column board-column"><div class="card-kicker">BOARD</div><div id="central-board-confidence" class="confidence-ring">78</div><div class="office-label">CONFIDENCE</div><div class="confidence-state">ON TARGET</div></div></div>
        </div>
      </div>
      <div class="career-control-strip"><div class="control-left"><span class="hint"><span class="hint-key">ENTER</span>Select</span><span class="hint"><span class="hint-key">ARROWS</span>Navigate</span><span class="hint"><span class="hint-key">F1</span>Main Menu</span><span class="hint"><span class="hint-key">F2</span>Career Central</span></div><div class="control-right">CENTRAL · MONDAY 17 AUGUST 2026</div></div>
    </div>
  </div>
</body>
</rml>
