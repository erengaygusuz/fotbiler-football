<rml>
<head>
  <title>Match HUD</title>
  <link type="text/rcss" href="theme.rcss" />
  <link type="text/rcss" href="runtime_shell.rcss" />
</head>
<body>
  <div class="runtime-screen" style="background-color:#1c553b;">
    <div style="position:absolute;left:0;top:0;width:100%;height:100%;background-color:#1c553b;"></div>
    <div style="position:absolute;left:4%;top:5%;width:92%;height:90%;border-width:2px;border-color:#dbe8df;"></div>
    <div style="position:absolute;left:39%;top:2%;width:22%;height:7%;background-color:#091a28;color:#ffffff;display:flex;align-items:center;justify-content:center;">
      <div style="width:32%;text-align:center;font-size:13px;font-weight:900;">RMA</div>
      <div id="hud-score" style="width:36%;text-align:center;font-size:20px;font-weight:900;color:#20d0b5;">0 - 0</div>
      <div style="width:32%;text-align:center;font-size:13px;font-weight:900;">FCB</div>
    </div>
    <div id="hud-clock" style="position:absolute;left:47%;top:9.5%;width:6%;height:3.5%;background-color:#f2f5f7;color:#071523;text-align:center;padding-top:5px;font-size:11px;font-weight:900;">19:24</div>

    <div style="position:absolute;left:3%;bottom:4%;width:23%;height:6%;background-color:#0b2030;color:#ffffff;padding:12px 15px;box-sizing:border-box;">
      <div style="display:flex;justify-content:space-between;"><div id="hud-home-player" style="font-size:13px;font-weight:900;">RONALDO</div><div style="color:#20d0b5;font-size:11px;">LW</div></div>
      <div style="margin-top:4px;height:4px;background-color:#29485d;"><div style="width:76%;height:4px;background-color:#20d0b5;"></div></div>
    </div>

    <div style="position:absolute;right:3%;bottom:4%;width:23%;height:6%;background-color:#0b2030;color:#ffffff;padding:12px 15px;box-sizing:border-box;">
      <div style="display:flex;justify-content:space-between;"><div style="color:#e84b8f;font-size:11px;">ST</div><div id="hud-away-player" style="font-size:13px;font-weight:900;">SUAREZ</div></div>
      <div style="margin-top:4px;height:4px;background-color:#29485d;"><div style="width:69%;height:4px;background-color:#e84b8f;"></div></div>
    </div>

    <div style="position:absolute;left:41%;bottom:3%;width:18%;height:16%;background-color:#0a1f2d;border-width:1px;border-color:#527286;">
      <div style="position:absolute;left:49%;top:0;width:1%;height:100%;background-color:#75909f;"></div>
      <div style="position:absolute;left:6%;top:18%;width:7px;height:7px;background-color:#20d0b5;"></div>
      <div style="position:absolute;left:18%;top:66%;width:7px;height:7px;background-color:#20d0b5;"></div>
      <div style="position:absolute;left:33%;top:42%;width:7px;height:7px;background-color:#20d0b5;"></div>
      <div style="position:absolute;right:8%;top:22%;width:7px;height:7px;background-color:#e84b8f;"></div>
      <div style="position:absolute;right:25%;top:61%;width:7px;height:7px;background-color:#e84b8f;"></div>
      <div style="position:absolute;right:37%;top:44%;width:7px;height:7px;background-color:#e84b8f;"></div>
      <div style="position:absolute;left:49%;top:47%;width:8px;height:8px;background-color:#ffffff;"></div>
    </div>

    <div style="position:absolute;left:3%;top:3%;color:#e5eef2;font-size:10px;letter-spacing:1px;">M1C · MODERN MATCH HUD PREVIEW</div>
  </div>
</body>
</rml>